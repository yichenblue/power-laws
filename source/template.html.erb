<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <meta name="author" content="Yichen Wang">
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= canonical %>">
  <link rel="canonical" href="<%= canonical %>">
  <link rel="alternate" hreflang="<%= zh ? 'en' : 'zh-CN' %>" href="./<%= other_file %>">
  <link rel="icon" href="./assets/favicon.svg" type="image/svg+xml">
  <script src="./assets/js/theme.js"></script>
  <link rel="preload" href="./assets/fonts/research/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="./assets/fonts/research/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="./assets/css/reading-guide.css">
  <link rel="stylesheet" href="./assets/css/research-article.css">
  <link rel="stylesheet" href="./assets/css/standalone.css">
  <script src="./assets/js/reading-guide.js" defer></script>
  <script src="./assets/js/research-article.js" defer></script>
  <script src="./assets/vendor/mathjax/es5/tex-mml-chtml.js" defer></script>
</head>
<body class="research-article">
  <a class="skip-link" href="#article-start"><%= skip_label %></a>
  <main id="main" class="reading-layout">
    <article class="page">
      <div class="page__inner-wrap">
        <header id="article-start" tabindex="-1">
          <div class="article-tools">
            <button class="theme-button" type="button" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
              <span><%= zh ? '深色模式' : 'Dark mode' %></span>
            </button>
          </div>
          <h1 class="page__title"><%= title %></h1>
          <p class="reading-guide-note"><%= reading %></p>
        </header>
        <aside class="reading-guide" aria-label="<%= zh ? '文章导航' : 'Article navigation' %>">
          <details class="reading-guide__disclosure" open>
            <summary><%= toc_title %></summary>
            <nav aria-label="<%= zh ? '文章章节' : 'Article sections' %>">
              <ul>
                <li><a href="#article-start"><%= overview %></a></li>
                <% guide.fetch('sections').each do |section| %>
                <li><a href="#<%= CGI.escapeHTML(section.fetch('id')) %>"><%= CGI.escapeHTML(section.fetch('title')) %></a></li>
                <% end %>
              </ul>
            </nav>
          </details>
        </aside>
        <section class="page__content"><%= html %></section>
      </div>
    </article>
  </main>
</body>
</html>
